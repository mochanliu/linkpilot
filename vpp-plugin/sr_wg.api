/*
 * sr_wg.api - SR-WG Binary API 定义
 */

option version = "1.0.0";

import "vnet/ip/ip_types.api";
import "vnet/interface_types.api";

/* ==================== 类型定义 ==================== */

typedef sr_wg_segment
{
  vl_api_ip4_address_t ip;
  u16 port;
};

/*
 * 一条 SR 路径 = **只有中间跳**。终点那一段不在这里：它由 encap 从即将发出的
 * 那个报文的外层 dst 现取（见 sr_wg_tunnel_set_path 与 sr_wg4_encap.c）。
 * 把终点写进表里就是存下一个会漂移、且参与 HMAC 的值。
 *
 * relays[0] 是离终点最近的中转，relays[relay_count-1] 是第一跳（"首跳免费"，
 * 由改写后的外层 IP/UDP 承载），与 sr_header.h 的段序约定一致。
 */
typedef sr_wg_path
{
  u16 path_id;
  u16 hmac_id;
  u8 relay_count;
  u8 active;
  vl_api_sr_wg_segment_t relays[8];
};

/* ==================== Service 定义 ==================== */

service {
  rpc sr_wg_path_add_del returns sr_wg_path_add_del_reply;
  rpc sr_wg_path_dump returns stream sr_wg_path_details;
  rpc sr_wg_key_set returns sr_wg_key_set_reply;
  rpc sr_wg_key_del returns sr_wg_key_del_reply;
  rpc sr_wg_key_dump returns stream sr_wg_key_details;
  rpc sr_wg_transit_enable returns sr_wg_transit_enable_reply;
  rpc sr_wg_transit_disable returns sr_wg_transit_disable_reply;
  rpc sr_wg_tunnel_set_path returns sr_wg_tunnel_set_path_reply;
  rpc sr_wg_tunnel_dump returns stream sr_wg_tunnel_details;
  rpc sr_wg_port_add_del returns sr_wg_port_add_del_reply;
  rpc sr_wg_port_dump returns stream sr_wg_port_details;
  rpc sr_wg_encap_enable returns sr_wg_encap_enable_reply;
  rpc sr_wg_encap_fib_set returns sr_wg_encap_fib_set_reply;
  rpc sr_wg_rebind_ports returns sr_wg_rebind_ports_reply;
  rpc sr_wg_config_dump returns stream sr_wg_config_details;
  rpc sr_wg_obs_dump returns stream sr_wg_obs_details;
  rpc sr_wg_obs_clear returns sr_wg_obs_clear_reply;
  rpc sr_wg_stats_get returns sr_wg_stats_get_reply;
  rpc sr_wg_stats_clear returns sr_wg_stats_clear_reply;
  rpc sr_wg_probe_set returns sr_wg_probe_set_reply;
  rpc sr_wg_probe_dump returns stream sr_wg_probe_details;
  rpc sr_wg_probe_send returns sr_wg_probe_send_reply;
};

/* ==================== Path API ==================== */

/** \brief 增/改/删一条 SR 路径
    @param is_add      - 1 = 新增或按 path_id 覆盖，0 = 删除
    @param hmac_id     - 签名密钥标识。**密钥表里必须已有这把钥匙**，
                         否则本请求返回 NO_SUCH_ENTRY：路径存的是密钥副本，
                         缺钥匙时若用全零密钥建路径，包能正常发出去但对端
                         一律验签失败，控制器完全看不出来。
    @param relay_count - 中转跳数，0..7（上限见 SR_MAX_RELAYS）。允许 0：
                         没有中转跳的隧道仍带 SR 头，那个头证明"发端持有这把
                         P-Key"，是收端把外层源记成 verified 观测的唯一凭证。
    @param relays      - 前 relay_count 项有效：relays[0] 离终点最近，
                         relays[relay_count-1] 是第一跳。**不含终点**，终点段
                         由 encap 从报文外层 dst 现取，因此对端地址/端口怎么变
                         都不需要重建路径。
    @note              - is_add=0 时，指向该路径的隧道绑定会被一并摘除
                         （悬空绑定只会在收包时按 encap_no_path 静默丢包）
*/
autoreply define sr_wg_path_add_del
{
  u32 client_index;
  u32 context;
  u8 is_add;               /* 1=add/update, 0=delete */
  u16 path_id;
  u16 hmac_id;
  u8 relay_count;
  u8 active;
  vl_api_sr_wg_segment_t relays[8];
};

define sr_wg_path_dump
{
  u32 client_index;
  u32 context;
  u16 path_id;            /* ~0 (0xffff) = dump all；path_id 0 是合法值 */
};

define sr_wg_path_details
{
  u32 context;
  u16 path_id;
  u16 hmac_id;
  u8 relay_count;
  u8 active;
  vl_api_sr_wg_segment_t relays[8];
};

/* ==================== Key API ==================== */

/** \brief 下发/轮换一把 P-Key
    @note 路径表里存的是密钥**副本**。本请求会把新值同步刷进所有引用该
          hmac_id 的路径，因此轮换密钥只需一次 key_set，不需要重建路径；
          换密钥请直接用 key_set，不要先 key_del 再 key_set。
*/
autoreply define sr_wg_key_set
{
  u32 client_index;
  u32 context;
  u16 hmac_id;
  u8 key[16];             /* 128-bit P-Key */
};

/** \brief 删除一把 P-Key
    @note 仍有路径引用该 hmac_id 时返回 INVALID_VALUE（不是静默删除）
*/
autoreply define sr_wg_key_del
{
  u32 client_index;
  u32 context;
  u16 hmac_id;
};

define sr_wg_key_dump
{
  u32 client_index;
  u32 context;
};

define sr_wg_key_details
{
  u32 context;
  u16 hmac_id;
};

/* ==================== Transit API ==================== */

/** \brief 启用 SR 中转（只验签 + 弹一段 + 改外层 dst，不解密）
    @param port - 本机收 SR 包的目的 UDP 端口。**加入** transit 端口集合并重注册，
                  所以一台中转可以同时服务多个端口（多租户各一个）。
    @note 中转**绝不改写外层源 IP/端口**：目的端 wg4-input 按 peer endpoint
          校验外层源，改源会让对端丢包并把 peer 的动态 endpoint 污染到中转。
*/
autoreply define sr_wg_transit_enable
{
  u32 client_index;
  u32 context;
  u16 port;               /* transit UDP port */
};

autoreply define sr_wg_transit_disable
{
  u32 client_index;
  u32 context;
};

/* ==================== Encap API ==================== */

/** \brief 绑定 / 解绑 WG 隧道接口到 SR 路径
    @param sw_if_index - WG 隧道接口的 sw_if_index（一接口一绑定，配置侧靠它定位）
    @param path_id     - 路径标识（必须已存在于路径表）
    @param src_port    - **本端**的外层 UDP 源端口 = 这条隧道的监听端口。
                         encap 数据面就按它选路：本数据面每隧道一个监听端口
                         （定案 2），WG 发包时把它写进外层源端口，所以本机发出
                         的包自带隧道身份。传 0 = 还没给出可用的键，本绑定只出现在
                         dump 里、数据面永不命中（`show sr-wg tunnels` 标未生效）。
                         对端地址不再是键：它可能学自 NAT、会变、也可能压根没配。
                         两张接口填同一个 src_port 时后写的赢 —— 本数据面是点对点
                         隧道，不做端口重复防护。
    @param is_add      - 1 = 绑定，0 = 解绑
                         注意：不会自动启用 feature，需另发
                         sr_wg_encap_enable 到 underlay 接口
*/
autoreply define sr_wg_tunnel_set_path
{
  u32 client_index;
  u32 context;
  u8 is_add;
  u32 sw_if_index;
  u16 path_id;
  u16 src_port;
};

/** \brief 设置隧道接口的 FEC 比例（插件 1.2.0，docs/fec-and-lb-plan.md §9）
    @param sw_if_index - WG 隧道接口（必须已有 sr_wg_tunnel_set_path 绑定）
    @param fec_ratio   - 0 = 关；1..4 = 每 ratio 个数据包 1 个异或冗余包
                         （1 = 整包复制，对端 WG 反回放去重）
    独立成消息而不是扩 tunnel_set_path：老插件收到这条消息只会报
    "message not found"，绑定本身照常成功 —— agent 对旧插件的升级窗口内
    隧道不因 FEC 探测而中断。
*/
autoreply define sr_wg_fec_set
{
  u32 client_index;
  u32 context;
  u32 sw_if_index;
  u8 fec_ratio;
};

define sr_wg_tunnel_dump
{
  u32 client_index;
  u32 context;
  u32 sw_if_index;          /* ~0 = dump all */
};

define sr_wg_tunnel_details
{
  u32 context;
  u32 sw_if_index;
  u16 path_id;
  u16 src_port;             /* 本端外层源端口；0 = 数据面永不命中 */
  u8 is_effective;          /* src_port 已填 且 至少一个 underlay 接口
                               启用了 sr-wg4-encap；0 = 会静默旁路 */
};

/** \brief 在 ip4-output arc 上启用 / 禁用 sr-wg4-encap feature
    @param sw_if_index - **underlay 出口接口** 的 sw_if_index（不是 wg0：
                          wg4-output-tun 不进入 feature 链，挂 wg0 收不到包）
    @param enable      - 1 = 启用，0 = 禁用
*/
autoreply define sr_wg_encap_enable
{
  u32 client_index;
  u32 context;
  u32 sw_if_index;
  u8 enable;
};

/* ==================== Stats API ==================== */

define sr_wg_stats_get
{
  u32 client_index;
  u32 context;
};

define sr_wg_stats_get_reply
{
  u32 context;
  i32 retval;
  u64 encap_ok;
  u64 encap_no_path;
  u64 encap_hmac_fail;
  u64 encap_bypass;
  u64 encap_no_headroom;
  u64 transit_ok;
  u64 transit_hmac_fail;
  u64 transit_seg_exhausted;
  u64 transit_bad_magic;
  u64 transit_bad_ver;
  u64 transit_bad_len;
  u64 decap_ok;
  u64 decap_hmac_fail;
  u64 decap_seg_not_zero;
  u64 decap_bypass;
  u64 drop_total;
};

autoreply define sr_wg_stats_clear
{
  u32 client_index;
  u32 context;
};

/* ==================== 端口/挂点配置 API ==================== */

/** \brief 按当前**端口集合**重新注册 UDP 目的端口（vpn_ports -> sr-wg4-input，
           transit_ports -> sr-wg4-transit）
    @note 建 WireGuard 接口时 wireguard 插件会把**该接口的** listen-port 重新
          注册给自己的 wg4-input，把 sr-wg4-input 的旁路入口摘掉；每隧道一个
          端口之后被覆盖的是那一条隧道的端口。等价于 CLI `set sr-wg
          rebind-ports`。控制器必须在**创建 WG 接口之后**调用它。
*/
autoreply define sr_wg_rebind_ports
{
  u32 client_index;
  u32 context;
};

/** \brief 设置 encap 改写外层 dst 之后重新查表用的 FIB index
    @note 等价于 CLI `set sr-wg encap fib-index <n>`；缺省 0 = main table。
*/
autoreply define sr_wg_encap_fib_set
{
  u32 client_index;
  u32 context;
  u32 fib_index;
};

/** \brief 增/删一个 UDP 目的端口（每隧道一个端口，定案 2）
    @param kind  - 0 = vpn（WG 隧道监听端口 -> sr-wg4-input）
                  1 = transit（中转收 SR 包的端口 -> sr-wg4-transit）
    @param port  - 1..65535，0 直接 INVALID_VALUE
    @note add 是**幂等**的且每次都会把端口重挂回本插件的节点：建 WG 接口时
          wireguard 会把该接口的 listen-port 抢回 wg4-input，所以 agent 的
          正确顺序是 CreateInterface -> 本请求 -> sr_wg_rebind_ports。
    @note del 一个 vpn 端口会把端口**交回 wg4-input**（那条隧道仍可当普通 WG
          用），不是简单反注册；del transit 端口才反注册。
*/
autoreply define sr_wg_port_add_del
{
  u32 client_index;
  u32 context;
  u8 is_add;
  u8 kind;
  u16 port;
};

/** \brief dump 本节点登记的 UDP 端口集合（vpn 与 transit 各一条） */
define sr_wg_port_dump
{
  u32 client_index;
  u32 context;
};

define sr_wg_port_details
{
  u32 context;
  u8 kind;                  /* 同 sr_wg_port_add_del.kind */
  u16 port;
};

/** \brief 读回插件全局配置（控制器对账用；路径/密钥/绑定另有各自的 dump）
    @note 端口是**集合**（每隧道一个端口），这里只给数量；端口内容由
          sr_wg_port_dump 逐条读 —— 一张 CPE 上几十条隧道时定长数组放不下。
*/
define sr_wg_config_dump
{
  u32 client_index;
  u32 context;
};

define sr_wg_config_details
{
  u32 context;
  u16 vpn_port_count;
  u16 transit_port_count;
  u8  transit_enabled;
  u32 encap_fib_index;
  u32 n_enabled_ifs;              /* 下面数组的有效长度，最多 32 */
  u32 enabled_ifs[32];            /* 已启用 sr-wg4-encap 的 underlay 接口 */
  /*
   * 计数用 u32：路径表容量已经是 4096（一条隧道一条路径），u8 会在 256 条
   * 之后回绕 —— 而"回绕成小数"在对账时看起来像"路径被删了"。
   */
  u32 path_count;
  u32 key_count;
  u32 obs_count;                  /* 观测表当前条目数 */
  u64 obs_records;                /* 累计记录次数（含命中已有槽位） */
  u64 obs_evictions;              /* 槽冲突挤掉旧条目次数：上涨=有人在灌假源 */
};

/* ==================== 外层源观测 API（vBOND 地址发现） ==================== */

/** \brief dump 本节点观测到的外层源元组
    @note 时间只给 **age_sec**（dump 时刻减去最后一次看到它的秒数），不给绝对
          时间戳：插件里的时钟是"相对 VPP 启动"的，绝对值对控制器毫无意义。
          agent 上报时给自己的墙钟时间戳即可。
    @note verified=0 的条目是**候选**映射，不是结论（见 sr_obs.h：观测点在
          WireGuard 解密之前，旁路包的外层源无法本地认证）。控制器要么用该
          节点自己的上报交叉确认，要么用"按它建隧道后握手真成功"追认。
    @note verified=1 认证的也不是地址：SR HMAC 只覆盖 ver_flags..segments，
          外层 IP 头不在签名里，链路上的 NAT 照样会改写源地址。它证明的是
          "有一个持有 p-key 的对端此刻在用这个 (ip:port) 发包"。
*/
define sr_wg_obs_dump
{
  u32 client_index;
  u32 context;
};

define sr_wg_obs_details
{
  u32 context;
  vl_api_ip4_address_t src_ip;    /* 观测到的外层源 IPv4 */
  u16 src_port;
  u16 dst_port;                   /* 本机被观测到的目的端口 = 本节点 vpn_port */
  u32 rx_if;                      /* 收包接口 sw_if_index */
  u32 hits;
  u32 age_sec;                    /* 距最后一次看到本元组过了多少秒 */
  u8  verified;                   /* 1 = 至少一次观测来自 SR HMAC 校验通过的包 */
};

/** \brief 清空观测表（"从这里开始重新观测"，records/evictions 一并归零，
           由 config_dump 读回）
    @note 归属重做发现时用；不清也行——表是有界的直接映射，旧条目会被挤掉。
*/
autoreply define sr_wg_obs_clear
{
  u32 client_index;
  u32 context;
};

/* ==================== 隧道内探针 API（延迟/抖动/丢包） ==================== */

/** \brief 建/改/删一条质量探针会话
    @param is_add      - 1 = 新增或按 sw_if_index 覆盖，0 = 删除（幂等）
    @param sw_if_index - **本地 WG 隧道接口**（探针走它的 overlay 路由）
    @param peer_ip     - 对端 overlay /32（内层目的地址）。必填
    @param local_ip    - 本端 overlay 地址（内层源）。传 0.0.0.0 时取该接口的
                         第一个 IPv4 地址；探针的内层源必须对端 allowed-ips 能
                         接受（定案：恒 0.0.0.0/0），故一般就是接口地址
    @param interval_ms - 发送间隔，0 = 默认 300ms；允许 10..60000
    @param timeout_ms  - 判丢超时，0 = 3×interval；必须 >= interval
    @note 探针与 BFD 是**两套会话表**：BFD 只给可达性，本表给延迟/抖动/丢包。
          北向/CLI 合成一张视图，不要试图让一个协议兼任两件事。
*/
autoreply define sr_wg_probe_set
{
  u32 client_index;
  u32 context;
  u8 is_add;
  u32 sw_if_index;
  vl_api_ip4_address_t peer_ip;
  vl_api_ip4_address_t local_ip;
  u32 interval_ms;
  u32 timeout_ms;
};

/** \brief dump 全部探针会话及指标 */
define sr_wg_probe_dump
{
  u32 client_index;
  u32 context;
};

define sr_wg_probe_details
{
  u32 context;
  u32 sw_if_index;
  vl_api_ip4_address_t peer_ip;
  vl_api_ip4_address_t local_ip;
  u32 interval_ms;
  u32 timeout_ms;
  u8  enabled;
  u64 tx_packets;
  u64 rx_packets;
  u64 lost_packets;
  u64 late_replies;         /* 迟到（已判丢）或窗口外的回包 */
  u32 last_rtt_us;
  u32 min_rtt_us;
  u32 avg_rtt_us;
  u32 max_rtt_us;
  u32 jitter_us;            /* RFC3550 式 EWMA，抖动是 RTT 差值的滑动均值 */
  u32 loss_permille;        /* 最近 128 个样本窗口内的丢包率（千分比） */
};

/** \brief 立刻发一个探针（不等定时器）。e2e / 手工排查用
    @return 会话不存在时 NO_SUCH_ENTRY
*/
autoreply define sr_wg_probe_send
{
  u32 client_index;
  u32 context;
  u32 sw_if_index;
};
