module SDWAN-router {
    container SDWAN {
        container underlay {
            list tunnel {
                leaf source-port 4096;
                leaf description home-aliyunhk-aliyunbeijing;
                leaf action encapsulation;
                leaf argument 0;
                leaf private /etc/private;
                leaf public 123123;
                leaf destination-ip 0;
                leaf destination-port 4096;
                leaf MagicNumber 0;
                leaf FlowIDLen 0;
                leaf ProtoID 1;
                leaf SRLen 12;
                leaf SegType 1;
                leaf LastEntry 1;
                leaf SegLeft 1;
                leaf SRHLen 20;
                leaf OriSrc-ip 0;
                leaf OriSrc-port 0;
                leaf OriSrc-arg 0;
                leaf seg0-ip 0;
                leaf seg0-port 4096;
                leaf seg0-arg 0;
                leaf seg1-ip 8.210.246.191;
                leaf seg1-port 4096;
                leaf seg1-arg 0;
                leaf seg2-ip 0;
                leaf seg2-port 0;
                leaf seg2-arg 0;
                leaf seg3-ip 0;
                leaf seg3-port 0;
                leaf seg3-arg 0;
                leaf seg4-ip 0;
                leaf seg4-port 0;
                leaf seg4-arg 0;
            }
        }
    }
}
