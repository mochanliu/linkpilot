# Replay the installed customer configuration after VPP starts.
#
# Install on the box:
#   install -m 0755 sr-apply /usr/local/bin/sr-apply
#   install -m 0644 sr-apply.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable sr-apply.service
#
# Cold boot is ordered: VPP must be up before tables/MTU/lcp can be replayed,
# and FRR starts after the config file has been restored, because FRR reads
# /etc/frr/frr.conf itself at start.
#
# A VPP-only restart (crash or `systemctl restart vpp`) is the other path, and
# it is why this unit is PartOf/WantedBy vpp.service: a stopped or restarted VPP
# takes every lcp TAP with it, so the replay has to run again, not just at boot.
# FRR keeps running through that restart and still holds the old interfaces; on
# the probe box its default-VRF address never came back into VPP until FRR was
# restarted (2026-10-28). ExecStartPost restarts it after the replay, so FRR is
# also brought back if it was down when VPP returned; --no-block keeps this unit
# from waiting on a job that is ordered after it (Before=frr.service).
#
# A box with no installed version exits 0: ConditionPathExists skips the unit
# instead of reporting a failure on a device that was never configured.
[Unit]
Description=sr-cpe replay device configuration (VPP + kernel)
After=vpp.service
Wants=vpp.service
PartOf=vpp.service
Before=frr.service
ConditionPathExists=/var/lib/sr-cpe/current

[Service]
Type=oneshot
RemainAfterExit=yes
# vpp.service is considered started before the CLI socket answers. vppctl exits
# 1 with "connect: No such file or directory" until it does, so wait (bounded)
# instead of racing the replay.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do vppctl show version >/dev/null 2>&1 && exit 0; sleep 1; done; echo "vpp CLI did not come up" >&2; exit 1'
ExecStart=/usr/local/bin/sr-apply boot
ExecStartPost=/bin/sh -c 'systemctl --no-block restart frr.service 2>/dev/null || true'
TimeoutStartSec=120

[Install]
WantedBy=vpp.service
